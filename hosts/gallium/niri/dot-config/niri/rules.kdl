recent-windows {
    binds {
        super+Tab         { next-window     scope="workspace"; }
        super+Shift+Tab   { previous-window scope="workspace"; }
    }
}
overview {
    zoom 0.3
}   
window-rule {
    draw-border-with-background false
    geometry-corner-radius 0
}

blur {
    passes 2
    offset 7
    noise 0.013
    saturation 1.6
}

window-rule {
  match title="foot"
  background-effect {
      blur true
      xray true
  }
}

window-rule {
  match title="[Ll]ibre[Ww]olf"
  open-maximized true
}

window-rule {
    match app-id=r#"librewolf"# title=r#"^Extension: \(Bitwarden Password Manager\) - Bitwarden — LibreWolf$"#
    open-floating true
    block-out-from "screen-capture"
    default-column-width { fixed 450; }
}

window-rule {
  match title="Helium"
  open-maximized true
}

window-rule {
    match app-id="clip|imv|xdg-desktop-portal-gtk"
    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 720; }
}
window-rule {
    match app-id="dev.noctalia.luciole-chooser"
    background-effect {
        blur true
    }
    popups {
        geometry-corner-radius 0
        background-effect {
            blur true
        }
    }
    default-column-width { fixed 1000; }
    default-window-height { fixed 800; }
    open-floating true
}
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}



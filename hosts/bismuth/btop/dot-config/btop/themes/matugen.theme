# Matugen template for btop

theme[main_bg]=""

theme[main_fg]="#e4e2e3"
theme[title]="#b9c8de"
theme[hi_fg]="#c2c7d0"
theme[selected_bg]="#b9c8de"

# Foreground color of selected item in processes box
theme[selected_fg]="#223041"

# Color of inactive/disabled text
theme[inactive_fg]="#c4c6cd"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#dabed7"

# Cpu box outline color
theme[cpu_box]="#4d525a"

# Memory/disks box outline color
theme[mem_box]="#4d525a"

# Net up/down box outline color
theme[net_box]="#4d525a"

# Processes box outline color
theme[proc_box]="#4d525a"

# Box divider line and small boxes line color
theme[div_line]="#4f5257"

# Temperature graph colors
theme[temp_start]="#c2c7d0"
theme[temp_mid]="#b9c8de"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#c2c7d0"
theme[cpu_mid]="#b9c8de"
theme[cpu_end]="#ffb4ab"

# Mem/Disk free meter
theme[free_start]="#c2c7d0"
theme[free_mid]=""
theme[free_end]="#4d525a"

# Mem/Disk cached meter
theme[cached_start]="#dabed7"
theme[cached_mid]=""
theme[cached_end]="#614b5f"

# Mem/Disk available meter
theme[available_start]="#b9c8de"
theme[available_mid]=""
theme[available_end]="#455365"

# Mem/Disk used meter
theme[used_start]="#ffb4ab"
theme[used_mid]=""
theme[used_end]="#a7060f"

# Download graph colors
theme[download_start]="#c2c7d0"
theme[download_mid]="#b9c8de"
theme[download_end]="#dabed7"

# Upload graph colors
theme[upload_start]="#c2c7d0"
theme[upload_mid]="#b9c8de"
theme[upload_end]="#dabed7"

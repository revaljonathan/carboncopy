# Matugen template for btop

theme[main_bg]=""

theme[main_fg]="#e4e1e9"
theme[title]="#bdc2ff"
theme[hi_fg]="#c5c4dd"
theme[selected_bg]="#bdc2ff"

# Foreground color of selected item in processes box
theme[selected_fg]="#24295f"

# Color of inactive/disabled text
theme[inactive_fg]="#c7c5d0"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#e7b9d5"

# Cpu box outline color
theme[cpu_box]="#4f5065"

# Memory/disks box outline color
theme[mem_box]="#4f5065"

# Net up/down box outline color
theme[net_box]="#4f5065"

# Processes box outline color
theme[proc_box]="#4f5065"

# Box divider line and small boxes line color
theme[div_line]="#51515a"

# Temperature graph colors
theme[temp_start]="#c5c4dd"
theme[temp_mid]="#bdc2ff"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#c5c4dd"
theme[cpu_mid]="#bdc2ff"
theme[cpu_end]="#ffb4ab"

# Mem/Disk free meter
theme[free_start]="#c5c4dd"
theme[free_mid]=""
theme[free_end]="#4f5065"

# Mem/Disk cached meter
theme[cached_start]="#e7b9d5"
theme[cached_mid]=""
theme[cached_end]="#6a475e"

# Mem/Disk available meter
theme[available_start]="#bdc2ff"
theme[available_mid]=""
theme[available_end]="#484d85"

# Mem/Disk used meter
theme[used_start]="#ffb4ab"
theme[used_mid]=""
theme[used_end]="#a7060f"

# Download graph colors
theme[download_start]="#c5c4dd"
theme[download_mid]="#bdc2ff"
theme[download_end]="#e7b9d5"

# Upload graph colors
theme[upload_start]="#c5c4dd"
theme[upload_mid]="#bdc2ff"
theme[upload_end]="#e7b9d5"

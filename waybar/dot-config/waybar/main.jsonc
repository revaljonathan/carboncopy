{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    "spacing": 6, // Gaps between modules (4px)
    "margin-top": 0,
    "margin-bottom": 0,

    "modules-left": [
        "niri/workspaces",
        "custom/sep",
        "niri/window",
        "custom/sep",
    ],

    "modules-right": [
        "clock",
        "custom/sep",
        "battery",
        "custom/sep",
        "custom/caf-waybar",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "pulseaudio#microphone",
        "custom/sep",
        "backlight",
        "custom/sep",
        "network",
        "custom/sep",
      "mpris",
       "custom/sep",
        "memory",
        "custom/sep",
        "temperature",
    ],

"custom/caf-waybar": {
    "exec": "pgrep sleep.sh >/dev/null && echo 'Sleepy' || echo 'Caffeinated'",
    "signal": 13,
    "format": "{}",
    "tooltip": false
}, 
"custom/sep": {
  "format": "|",
    "interval": "once",
    "tooltip": false
},
"niri/window": {
  "max-length": 55
},
"niri/workspaces": {
    "on-click": "activate",
    "all-outputs": true,
    "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
        "4": [],
        "5": []
    },
    "format": "{icon}"
},

    "clock": {
        "format": "{:%a, %d %b %H:%M}",
        "format-alt": "{:%H:%M}",
    },



    "memory": {
        "format": "Mem: {used:0.1f}GiB",
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "Temp: {temperatureC}°C",
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "Light: {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "Bat: {capacity}%",
        "format-discharging": "Bat: {capacity}% - {time}",
        "format-full": "Bat: {capacity}%",
        "format-charging": "Charging: {capacity}%",
        "format-plugged": "Bat: {capacity}%",
    },

    "network": {
        "format-wifi": "Net: {essid} as {ipaddr}",
        "format-ethernet": "Net: {cidr}",
        "tooltip-format": "Network Information\n\nSSID  : {essid}\nIP    : {ipaddr}\nBand  : {frequency} MHz\nSignal: {signalStrength}%   \nvia   : {ifname}",
        "format-linked": "{ifname} (No IP) 󰊗",
        "format-disconnected": "Net error",
    },

    "pulseaudio": {
        "format": "Vol: {volume}%",
        "format-muted": "Vol: mute", 
        "on-click": "footclient --class=clip wiremix -v output",
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "Mic: {volume}%",
        "format-source-muted": "Mic: mute",
        "on-click": "footclient --class=clip wiremix -v input",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",
        "tooltip-format": "{source_desc} | {source_volume}%"
    },

    "mpris": {
        "format": "{title} - {artist}",
   "title-len": 25,
    "artist-len": 25,
        "format-paused": "{title} - {artist}",
    },
}

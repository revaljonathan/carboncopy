{
    "layer": "top", 
    "position": "top", 
    "height": 28,
    "spacing": 4, 
    "margin-top": 0,
    "margin-bottom": 0,

    "modules-left": [
        "niri/workspaces",
        "tray",
        "custom/sep",
        "niri/window",
        "custom/sep"
    ],

    "modules-center": [
        "custom/weather",
        "custom/sep",
        "clock"
    ],

    "modules-right": [
        "battery",
        "custom/sep",
        "wireplumber",
        "custom/sep",
        "network",
        "custom/sep",
        // "mpris",
        // "custom/sep",
        "memory",
       "custom/sep",
       "temperature",
        "custom/sep",
        "custom/caf-waybar"
    ],

"custom/caf-waybar": {
    "exec": "~/.local/bin/caf.sh status",
    "signal": 13,
    "format": "{}",
    "interval": 900,
    "tooltip": false
}, 

"tray": {
    "icon-size": 13,
    "spacing": 10,
    "show-passive-items": false
},

"custom/sep": {
  "format": "|",
    "interval": "once",
    "tooltip": false
},
"custom/weather": {
  "format": "{}",
    "interval": 900,
    "exec": "~/.config/waybar/weather.sh",
    "on-click-right": "~/.config/waybar/weather.sh",
    "tooltip": false
},
"niri/window": {
  "max-length": 50
},
"niri/workspaces": {
    "on-click": "activate",
    "all-outputs": true
},

    "clock": {
        "format": "{:%a, %d %b %H:%M}",
        "tooltip": false
    },

    "memory": {
        "format": "Mem: {used:0.1f}GiB",
        "tooltip": false,
        "interval": 90
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "CPU: {temperatureC}°C",
        "interval": 90,
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "Bat: {capacity}%",
        "format-discharging": "Bat: {capacity}% - {time}",
        "format-full": "Bat: {capacity}%",
        "format-charging": "Charging: {capacity}%",
        "format-plugged": "Bat: {capacity}%",
        "tooltip": false,
        "interval": 90
    },

    "network": {
        "format-wifi": "Net: {essid}",
        "format-ethernet": "Net: {cidr}",
        "tooltip-format": "Network Information\n\nSSID  : {essid}\nIP    : {ipaddr}\nBand  : {frequency} MHz\nSignal: {signalStrength}%   \nvia   : {ifname}",
        "format-linked": "{ifname} (No IP) 󰊗",
        "format-disconnected": "Net: Disconnected",
        "on-click": "footclient --class=clip impala"
    },

    "wireplumber": {
        "format": "Vol: {volume}%",
        "format-muted": "Vol: mute", 
        "tooltip": false,
        "on-click": "footclient --class=clip wiremix -v output"
    },

    "mpris": {
        "format": "{title} - {artist}",
        "title-len": 55,
        "tooltip": false,
        "artist-len": 25,
            "format-paused": "{title} - {artist}"
        }
}

{
    "$schema":"https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.jso",
    "logo": {
    "type": "auto",
        "source": "~/.config/fastfetch/cat.txt",
        "position": "left",
    //        "width": 15,
    // "height": 4,
    "padding": {
        "top": 0,
        "left": 0,
        "right": 1,
        "bottom": 0
        }
},
    "color": {
        "1": "#eed49f"
    },
    "display": {
    	"stat": false,
        "size": {
        "binaryPrefix": "jedec"
    },
        "separator": " "
    },
    
"modules": [

  
     {
			"type": "os",
			"key": "OS:     ",
			"keyColor": "red"
		},
		{
			"type": "kernel",
			"key": "Kernel: ",
			"format": "{1} {2}",
			"keyColor": "red"
		},
		{
			"type": "packages",
			"key": "Packs:  ",
			"keyColor": "red"
		},
		{
			"type": "wm",
			"key": "WM:     ",
			"keyColor": "red"
		},
		{
			"type": "lm",
			"key": "Greeter:",
			"keyColor": "red"
		},
		{
			"type": "icons",
			"key": "Icons:  ",
			"keyColor": "red",
      "format": ""
		},
		{
			"type": "disk",
			"key": "Disk:     ",
			"keyColor": "blue"
		},
		{
			"type": "brightness",
			"key": "Backlight:",
			"keyColor": "blue"
		},
		{
			"type": "battery",
			"key": "Battery:  ",
			"keyColor": "blue"
		},
		{
			"type": "terminal",
			"key": "Term:     ",
			"keyColor": "blue"
		},
    		{
			"type": "font",
			"key": "Font:     ",
			"keyColor": "blue"
		},
		{
			"type": "terminalfont",
			"key": "Font:     ",
			"keyColor": "blue"
		},
		{
			"type": "shell",
			"key": "Shell:    ",
			"keyColor": "blue"
		},
		{
			"type": "host",
			"key": "Host:   ",
			"keyColor": "cyan"
		},
		{
			"type": "cpu",
			"key": "CPU:    ",
			"keyColor": "cyan",
      "format": "{name}"
		},
		{
			"type": "gpu",
			"key": "GPU:    ",
			"keyColor": "cyan",
      "format": "{vendor} {name}"
		},
		{
			"type": "display",
			"key": "Display:",
			"keyColor": "cyan"
		},
		{
			"type": "memory",
			"key": "Memory: ",
			"keyColor": "cyan"
		},
		{
			"type": "swap",
			"key": "Swap:   ",
      "separate": true,
			"keyColor": "cyan"
		},
		{
			"type": "uptime",
			"key": "Uptime: ",
			"keyColor": "cyan"
		},
        {
    "type": "command",
    "key": "Age:    ",
    "keyColor": "cyan",
    "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
},
]
    
}

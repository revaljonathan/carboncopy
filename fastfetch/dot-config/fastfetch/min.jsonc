{
    "$schema": "https://github.com",
    "logo": {
        "type": "auto",
        "source": "~/.config/fastfetch/small.txt",
        "position": "left",
        "padding": {
            "top": 0,
            "left": 1,
            "right": 1,
            "bottom": 0
        },
        "color": {
            "1": "yellow",
            "2": "yellow"
        }
    },
    "display": {
        "stat": false,
        "size": {
            "binaryPrefix": "jedec"
        },
        "separator": " "
    },
    "modules": [
        {
            "type": "title",
            "format": "{1}@{2}"
        },
        {
            "type": "os",
            "key": "OS:     ",
            "format": "",
            "keyColor": "red"
        }, 
        {
            "type": "command",
            "key": "Kernel: ",
            "format": "",
            "text": "uname -r",
            "keyColor": "green"
        },
                {
            "type": "command",
            "key": "WM:     ",
            "format": "",
             "text": "echo $XDG_CURRENT_DESKTOP",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "Shell:  ",
            "keyColor": "blue"
        },
        {
            "type": "cpu",
            "key": "CPU:    ",
            "keyColor": "magenta",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "Memory: ",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "Uptime: ",
            "keyColor": "@200"
        }
    ]
}

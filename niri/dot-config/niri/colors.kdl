layout {
	background-color "#16161c"

	focus-ring {
		active-color "#ecacc8"
		inactive-color "#26262c"
		urgent-color   "#ecacc8"
	}
	tab-indicator {
		active-color "#ecacc8"
		inactive-color "#26262c"
		urgent-color   "#ecacc8"
	}

	border {
		active-color "#ecacc8"
		inactive-color "#39393f"
		urgent-color   "#ecacc8"
	}
	insert-hint {
		color "#d09459"
	}
}
overview {
	backdrop-color "#16161c"
}

recent-windows {
	highlight {
		active-color "#90b0e7"
		urgent-color "#e08085"
	}
}

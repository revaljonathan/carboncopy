layout {
	background-color "#15171d"

	focus-ring {
		active-color "#ffbad8"
		inactive-color "#24282e"
		urgent-color   "#ffbad8"
	}
	tab-indicator {
		active-color "#ffbad8"
		inactive-color "#24282e"
		urgent-color   "#ffbad8"
	}

	border {
		active-color "#ffbad8"
		inactive-color "#373d43"
		urgent-color   "#ffbad8"
	}
	insert-hint {
		color "#ffb987"
	}
}
overview {
	backdrop-color "#15171d"
}

recent-windows {
	highlight {
		active-color "#94bdff"
		urgent-color "#ff7d83"
	}
}

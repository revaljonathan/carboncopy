layout {
	background-color "#161619"

	focus-ring {
		active-color "#f7a1c6"
		inactive-color "#262629"
		urgent-color   "#f7a1c6"
	}
	tab-indicator {
		active-color "#f7a1c6"
		inactive-color "#262629"
		urgent-color   "#f7a1c6"
	}

	border {
		active-color "#f7a1c6"
		inactive-color "#39393c"
		urgent-color   "#f7a1c6"
	}
	insert-hint {
		color "#e49a4f"
	}
}
overview {
	backdrop-color "#161619"
}

recent-windows {
	highlight {
		active-color "#82acf5"
		urgent-color "#f07077"
	}
}

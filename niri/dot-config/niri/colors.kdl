layout {
	background-color "#121619"

	focus-ring {
		active-color "#ffb5d5"
		inactive-color "#21272a"
		urgent-color   "#ffb5d5"
	}
	tab-indicator {
		active-color "#ffb5d5"
		inactive-color "#21272a"
		urgent-color   "#ffb5d5"
	}

	border {
		active-color "#ffb5d5"
		inactive-color "#343a3f"
		urgent-color   "#ffb5d5"
	}
	insert-hint {
		color "#d09a63"
	}
}
overview {
	backdrop-color "#121619"
}

recent-windows {
	highlight {
		active-color "#94bdff"
		urgent-color "#ff7d83"
	}
}

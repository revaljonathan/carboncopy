layout {
	background-color "#15171d"

	focus-ring {
		active-color "#fcbdd8"
		inactive-color "#24282e"
		urgent-color   "#fcbdd8"
	}
	tab-indicator {
		active-color "#fcbdd8"
		inactive-color "#24282e"
		urgent-color   "#fcbdd8"
	}

	border {
		active-color "#fcbdd8"
		inactive-color "#343a40"
		urgent-color   "#fcbdd8"
	}
	insert-hint {
		color "#f9ba8d"
	}
}
overview {
	backdrop-color "#15171d"
}

recent-windows {
	highlight {
		active-color "#99befa"
		urgent-color "#f88389"
	}
}

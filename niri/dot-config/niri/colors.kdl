layout {
	background-color "#16161c"

	focus-ring {
		active-color "#f7a1c6"
		inactive-color "#26262c"
		urgent-color   "#f7a1c6"
	}
	tab-indicator {
		active-color "#f7a1c6"
		inactive-color "#26262c"
		urgent-color   "#f7a1c6"
	}

	border {
		active-color "#f7a1c6"
		inactive-color "#39393f"
		urgent-color   "#f7a1c6"
	}
	insert-hint {
		color "#e49a4f"
	}
}
overview {
	backdrop-color "#16161c"
}

recent-windows {
	highlight {
		active-color "#82acf5"
		urgent-color "#f07077"
	}
}

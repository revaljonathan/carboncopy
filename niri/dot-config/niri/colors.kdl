layout {
	background-color "#121619"

	focus-ring {
		active-color "#ffa3cb"
		inactive-color "#21272a"
		urgent-color   "#ffa3cb"
	}
	tab-indicator {
		active-color "#ffa3cb"
		inactive-color "#21272a"
		urgent-color   "#ffa3cb"
	}

	border {
		active-color "#ffa3cb"
		inactive-color "#343a3f"
		urgent-color   "#ffa3cb"
	}
	insert-hint {
		color "#d09a63"
	}
}
overview {
	backdrop-color "#121619"
}

recent-windows {
	highlight {
		active-color "#80aeff"
		urgent-color "#ff8389"
	}
}

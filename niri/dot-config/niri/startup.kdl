spawn-at-startup "foot" "--server"
spawn-at-startup "mako"
spawn-at-startup "lxpolkit"
spawn-at-startup "gammastep" "-l" "-6.2:106.8" "-t" "6000:3500"
spawn-at-startup "~/.local/bin/caf.sh" "sleep"
spawn-at-startup "~/.local/bin/minosd"
spawn-at-startup "~/.local/bin/media.sh"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "-max-items" "100" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "-max-items" "100" "store"
spawn-sh-at-startup "until waybar -c ~/.config/waybar/config.jsonc -s ~/.config/waybar/style.css; do sleep 0.5; done"
spawn-sh-at-startup "swaybg -m fill -i \"$(cat ~/.config/wallpaper)\""

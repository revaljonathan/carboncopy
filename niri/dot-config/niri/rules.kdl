recent-windows {
    binds {
        super+Tab         { next-window     scope="workspace"; }
        super+Shift+Tab   { previous-window scope="workspace"; }
    }
}
overview {
    zoom 0.3
}   
window-rule {
    draw-border-with-background false
    geometry-corner-radius 0
}

blur {
    passes 2
    offset 6
    noise 0.013
    saturation 1.3
}

window-rule {
  match title="foot"
  background-effect {
      blur true
      xray true
  }
}

window-rule {
  match title="[Ll]ibre[Ww]olf"
  open-maximized true
}

window-rule {
    match app-id=r#"librewolf"# title=r#"^Extension: \(Bitwarden Password Manager\) - Bitwarden — LibreWolf$"#
    open-floating true
    block-out-from "screen-capture"
    default-column-width { fixed 450; }
}

window-rule {
  match title="Helium"
  open-maximized true
}

window-rule {
    match app-id="clip|imv|xdg-desktop-portal-gtk"
    open-floating true
    default-column-width { fixed 1129; }
    default-window-height { fixed 635; }
}

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}



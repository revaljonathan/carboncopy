anchor=top-right

margin=10
padding=10
border-size=1
border-radius=0


width=375
height=175
max-visible=5

font=IBM Plex Sans 11

text-alignment=left
max-icon-size=48
icons=1
icon-path=/usr/share/icons/hicolor

default-timeout=5000
ignore-timeout=0
group-by=app-name

sort=-time

on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss-all
on-touch=invoke-default-action

layer=top
format=<span foreground='#9a9aa1'>%a</span>\n<b>%s</b>\n<span>%b</span>
background-color=#26262c
text-color=#e8edf8
border-color=#525258
progress-color=over #26262c

[urgency=high]
border-color=#f07077    
